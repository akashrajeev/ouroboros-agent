# Copy to .env locally. Never commit .env or print its contents.
OURO_PROVIDER_ORDER=cloudflare,gemini,groq
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Pick a model with Workers AI JSON Mode support. No paid upgrade implied.
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional providers only used if explicitly added to OURO_PROVIDER_ORDER
OPENAI_API_KEY=
OPENAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OURO_CDP_URL=http://127.0.0.1:9222
OURO_CHROME=
OURO_AGENT_MAX_STEPS=12
# Optional comma-separated extra allowed origins. Task URLs and current origin also count.
OURO_ALLOWED_ORIGINS=
